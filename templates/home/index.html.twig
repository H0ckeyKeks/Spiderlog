{% extends 'base.html.twig' %}

{% block title %}Übersicht – SpiderLog{% endblock %}

{% block body %}
    {% set dueCount = entries|filter(e => e.status.value != 'ok')|length %}

    <div class="relative bg-gradient-to-br from-humus-900 via-humus-800 to-moss-900 text-sand-100 px-5 pt-8 pb-6 overflow-hidden rounded-b-3xl">
        <div class="absolute -top-10 -right-10 w-36 h-36 bg-moss-500/25 rounded-full blur-2xl"></div>
        <div class="absolute -bottom-8 -left-6 w-28 h-28 bg-clay-500/15 rounded-full blur-2xl"></div>
        <div class="relative">
            <p class="text-xs uppercase tracking-[0.2em] text-lichen-100">Übersicht</p>
            <h1 class="font-display text-2xl mt-1">{{ greeting }}</h1>
            <p class="text-sand-300/90 text-sm mt-1">
                {{ entries|length }} Spinne{{ entries|length != 1 ? 'n' : '' }}{% if dueCount > 0 %} · {{ dueCount }} Fütterung{{ dueCount != 1 ? 'en' : '' }} fällig{% endif %}
            </p>
        </div>
    </div>

    <div class="px-5 py-4 space-y-3">
        {% for entry in entries %}
            {% set spider = entry.spider %}
            {% set status = entry.status.value %}
            {% set styles = {
                overdue:  { avatar: 'from-clay-400 to-clay-600',     pill: 'bg-clay-50 text-clay-700',     dot: 'bg-clay-500' },
                due_soon: { avatar: 'from-lichen-400 to-lichen-600', pill: 'bg-lichen-50 text-lichen-600', dot: 'bg-lichen-400' },
                ok:       { avatar: 'from-moss-400 to-moss-600',     pill: 'bg-moss-100 text-moss-700',    dot: 'bg-moss-500' },
            } %}
            {% set style = styles[status] %}

            <a href="{{ path('app_spider_show', {name: spider.name}) }}" class="block bg-gradient-to-br from-white to-sand-50 rounded-3xl shadow-lift border border-humus-100/70 p-4 flex gap-3 items-center">
                <div class="w-14 h-14 rounded-2xl shrink-0 bg-gradient-to-br {{ style.avatar }} flex items-center justify-center shadow-inner overflow-hidden">
                    {% if spider.pictureLink %}
                        <img src="{{ asset('uploads/spiders/' ~ spider.pictureLink) }}" alt="" class="w-full h-full object-cover"
                             onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';">
                        <svg width="26" height="26" viewBox="0 0 96 96" class="text-sand-100/95 hidden" style="display:none">
                            <path d="M48 30c-6 0-10 5-10 12v9c0 8 4.5 13 10 13s10-5 10-13v-9c0-7-4-12-10-12Z" fill="currentColor" fill-opacity=".95"/>
                            <g stroke="currentColor" stroke-width="4.5" stroke-linecap="round" opacity=".85">
                                <path d="M38 34 27 27"/><path d="M36 40 24 37"/><path d="M36 47 23 47"/><path d="M38 54 25 58"/>
                                <path d="M58 34 69 27"/><path d="M60 40 72 37"/><path d="M60 47 73 47"/><path d="M58 54 71 58"/>
                            </g>
                        </svg>
                    {% else %}
                        <svg width="26" height="26" viewBox="0 0 96 96" class="text-sand-100/95">
                            <path d="M48 30c-6 0-10 5-10 12v9c0 8 4.5 13 10 13s10-5 10-13v-9c0-7-4-12-10-12Z" fill="currentColor" fill-opacity=".95"/>
                            <g stroke="currentColor" stroke-width="4.5" stroke-linecap="round" opacity=".85">
                                <path d="M38 34 27 27"/><path d="M36 40 24 37"/><path d="M36 47 23 47"/><path d="M38 54 25 58"/>
                                <path d="M58 34 69 27"/><path d="M60 40 72 37"/><path d="M60 47 73 47"/><path d="M58 54 71 58"/>
                            </g>
                        </svg>
                    {% endif %}
                </div>
                <div class="flex-1 min-w-0">
                    <p class="font-display text-lg text-humus-800 leading-tight">{{ spider.name }}</p>
                    <p class="text-xs text-humus-500">{{ spider.species.commonName ?? spider.species.latinName }}</p>
                    <span class="inline-flex items-center gap-1.5 mt-1.5 text-[11px] font-medium px-2 py-1 rounded-full {{ style.pill }}">
                        <span class="w-1.5 h-1.5 rounded-full {{ style.dot }}"></span>
                        {% if status == 'overdue' %}
                            Überfällig · seit {{ entry.daysSinceReference }} Tag{{ entry.daysSinceReference != 1 ? 'en' : '' }}
                        {% elseif status == 'due_soon' %}
                            Fällig in {{ entry.daysUntilDue }} Tag{{ entry.daysUntilDue != 1 ? 'en' : '' }}
                        {% else %}
                            Zuletzt gefüttert{% if entry.lastFeedingDays is not null %} · vor {{ entry.lastFeedingDays }} Tag{{ entry.lastFeedingDays != 1 ? 'en' : '' }}{% endif %}
                        {% endif %}
                    </span>
                </div>
            </a>
        {% else %}
            <p class="text-center text-humus-400 text-sm py-10">Noch keine Spinnen angelegt.</p>
        {% endfor %}
    </div>
{% endblock %}
