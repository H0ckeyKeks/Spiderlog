{% extends 'base.html.twig' %}

{% block title %}Spiderlog{% endblock %}

{% block body %}
    <div class="getInformation">
        <form>
            <select name="spider" onchange="this.form.submit()">
               {% for spider in spiders %}
                    <option value="{{ spider.id }}" {% if spider == selected %}selected{% endif %}>
                       {{ spider.name }}
                    </option>
               {% endfor %}
            </select>
        </form>

        <div class="actions">
            <div class="actions-top">
                <a href="#" class="action-button">Neue Art registrieren</a>
                <a href="#" class="action-button">Neue Spinne registrieren</a>
            </div>

            <a href="#" class="action-button">Spinne archivieren</a>
        </div>
    </div>

    <div class="informationTable">
        {%  if selected %}
        <table>
            <tr>
                <td rowspan="2"><img class="spiderpic" src="/uploads/spiders/{{ selected.pictureLink }}"></td>
                <th>Name</th>
                <th>Art</th>
                <th>Färbung</th>
                <th>Stadium</th>
                <th>Erworben am</th>
                <th>letzte Fütterung</th>
                <td rowspan="2">Ampellogo hier einfügen</td>
            </tr>

            <tr>
                <td>{{ selected.name }}</td>
                <td>{{ selected.species.latinName }} ({{ selected.species.commonName }})</td>
                <td>{{ selected.coloration }}</td>
                <td>{{ currentLifeStage.name }}</td>
                <td>{{ selected.dateAquired|date('d.m.Y') }}</td>
                <td>{% if lastFeedingDate %}
                        {{ lastFeedingDate|date('d.m.Y') }}
                    {% else %}
                        noch nie
                    {% endif %}
                </td>
            </tr>

        </table>
        {% else %}

        {% endif %}

    </div>

{% endblock %}
